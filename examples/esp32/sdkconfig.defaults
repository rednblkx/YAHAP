CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=16384
CONFIG_BT_NIMBLE_HOST_ALLOW_CONNECT_WITH_SCAN=y
CONFIG_BT_NIMBLE_HOST_QUEUE_CONG_CHECK=y
CONFIG_BT_NIMBLE_ENC_ADV_DATA=y
CONFIG_BT_NIMBLE_OPTIMIZE_MULTI_CONN=y
# Classic ESP32: BT modem sleep (ORIG mode, main-XTAL low-power clock) causes BLE
# connection supervision timeouts (0x208) shortly after connect on this silicon
# revision. Disable it — the controller stays awake while BT is enabled.
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_PM_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_IEEE802154_ENABLED=n
CONFIG_LOG_VERSION_2=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y